{
  "name": "esn-cy/omnia",
  "type": "drupal-module",
  "description": "An umbrella of services designed to help ESN digitalize its operations.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/esn-cy/omnia",
  "readme": "README.md",
  "support": {
    "email": "wpa@esncy.org",
    "issues": "https://github.com/esn-cy/omnia/issues"
  },
  "authors" : [
    {
      "name": "Andreas Michael",
      "email": "ateasm03@gmail.com",
      "role": "Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Drupal\\omnia\\": "src/"
    }
  },
  "require": {
    "esn/esn_accounts_api": "^1.1",
    "drupal/simple_oauth": "^6.1",
    "stripe/stripe-php": "^20.1",
    "google/auth": "^1.50",
    "google/apiclient": "^2.19",
    "google/apiclient-services": "^v0.456",
    "pkpass/pkpass": "^2.5.1",
    "ext-fileinfo": "*",
    "symfony/intl": "^6.4 || ^7.0 || ^8.0"
  },
  "require-dev": {
    "drupal/core-dev": "^10"
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true,
      "drupal/core-composer-scaffold": false,
      "phpstan/extension-installer": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "php-http/discovery": true,
      "tbachert/spi": true
    }
  },
  "repositories": {
    "drupal": {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    },
    "esn": {
      "type": "composer",
      "url": "https://packages.esn.org"
    }
  }
}
